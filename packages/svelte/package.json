    "./TextboxA": {
      "svelte": "./src/TextboxA.svelte",
      "default": "./src/TextboxA.svelte"
    },
    "./Toggle": {
      "svelte": "./src/Toggle.svelte",
      "default": "./src/Toggle.svelte"
    },
    "./utils": {
      "import": "./src/utils.ts",
      "types": "./src/utils.ts"
    },
    "./types/DatePicker": {
      "types": "./types/DatePicker.d.ts",
