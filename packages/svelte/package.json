      "default": "./src/DatePicker.svelte"
    },
    "./DatePickerInput": {
      "svelte": "./src/DatePickerInput.svelte",
      "default": "./src/DatePickerInput.svelte"
    },
    "./Digitbox": {
      "svelte": "./src/Digitbox.svelte",
      "default": "./src/Digitbox.svelte"
    },
    "./Dropdown": {
      "svelte": "./src/Dropdown.svelte",
      "default": "./src/Dropdown.svelte"
    },
    "./DualSlider": {
      "svelte": "./src/DualSlider.svelte",
      "default": "./src/DualSlider.svelte"
    },
    "./GridView": {
      "svelte": "./src/GridView.svelte",
      "default": "./src/GridView.svelte"
    },
    "./ImageCarousel": {
      "svelte": "./src/ImageCarousel.svelte",
      "default": "./src/ImageCarousel.svelte"
    },
    "./Panel": {
      "svelte": "./src/Panel.svelte",
      "default": "./src/Panel.svelte"
    },
    "./Slider": {
      "svelte": "./src/Slider.svelte",
      "default": "./src/Slider.svelte"
    },
    "./SmartGridView": {
      "svelte": "./src/SmartGridView.svelte",
      "default": "./src/SmartGridView.svelte"
