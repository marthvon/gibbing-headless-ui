{
  "name": "@marthvon/gibbing-headless-ui-svelte",
  "version": "0.1.0",
  "description": "Headless UI for Svelte 5+",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/marthvon/gibbing-headless-ui.git",
    "directory": "packages/svelte"
  },
  "keywords": [
