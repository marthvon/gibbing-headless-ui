{
  "name": "@marthvon/gibbing-headless-ui",
  "version": "0.2.3",
  "description": "Headless UI for React, integrates with Next.js well",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/marthvon/gibbing-headless-ui.git",
    "directory": "packages/react"
  },
  "keywords": [
    "Components",
    "HeadlessUi",
    "React",
    "UI",
    "UX"
  ],
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@marthvon/frontail": ">=0.5.1"
  },
  "exports": {
    "./card.a": {
      "import": "./dist/card.a.js",
      "types": "./types/card.a.d.ts"
    },
    "./card.b": {
      "import": "./dist/card.b.js",
      "types": "./types/card.b.d.ts"
    },
    "./date_picker": {
      "import": "./dist/date_picker.js",
      "types": "./types/date_picker.d.ts"
    },
    "./date_picker_input": {
      "import": "./dist/date_picker_input.js",
      "types": "./types/date_picker_input.d.ts"
    },
    "./digitbox": {
      "import": "./dist/digitbox.js",
      "types": "./types/digitbox.d.ts"
    },
    "./dropdown": {
      "import": "./dist/dropdown.js",
      "types": "./types/dropdown.d.ts"
    },
    "./dual_slider": {
      "import": "./dist/dual_slider.js",
      "types": "./types/dual_slider.d.ts"
    },
    "./grid_view": {
      "import": "./dist/grid_view.js",
      "types": "./types/grid_view.d.ts"
    },
    "./image_carousel": {
      "import": "./dist/image_carousel.js",
      "types": "./types/image_carousel.d.ts"
    },
    "./panel": {
      "import": "./dist/panel.js",
      "types": "./types/panel.d.ts"
    },
    "./slider": {
      "import": "./dist/slider.js",
      "types": "./types/slider.d.ts"
    },
    "./smart_grid_view": {
      "import": "./dist/smart_grid_view.js",
      "types": "./types/smart_grid_view.d.ts"
    },
    "./textbox.a": {
      "import": "./dist/textbox.a.js",
      "types": "./types/textbox.a.d.ts"
    },
    "./toggle": {
      "import": "./dist/toggle.js",
      "types": "./types/toggle.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./types/utils.d.ts"
    },
    "./presets.server": {
      "import": "./dist/presets.server.js",
      "types": "./types/presets.server.d.ts"
    },
    "./presets.client": {
      "import": "./dist/presets.client.ts"
    }
  },
  "scripts": {
    "build": "npx tsc && cp src/presets.client.ts dist/ && rm -f dist/presets.client.js types/presets.client.d.ts && ../../min.sh dist && ../../nexify.sh dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "types/"
  ],
  "author": "marthvon",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  }
}
