{
  "name": "gibbing-headless-ui",
  "private": true,
  "workspaces": [
    "packages/*",
    "demo/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:react": "npm run build -w @marthvon/gibbing-headless-ui",
    "demo:react": "npm run dev -w gibbing-demo-react",
    "demo:svelte": "npm run dev -w gibbing-demo-svelte",
    "ai-guide": "node scripts/ai-guide.mjs",
    "ai-guide:check": "node scripts/ai-guide.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  },
  "version": ""
}
